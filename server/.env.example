# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://helpdesk:helpdesk123@localhost:5432/helpdesk_db

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# MAX Messenger Bot (получить у @MasterBot в приложении MAX)
MAX_BOT_TOKEN=your-max-bot-token
MAX_API_URL=https://botapi.max.ru

# Client
CLIENT_URL=http://localhost:5173

# Server URL (for bot API calls)
API_URL=http://localhost:5000/api
